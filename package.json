{
  "name": "daman-duo",
  "productName": "Daman Duo",
  "version": "1.4.0",
  "description": "Daman Duo - an open-world 3D action game set in Daman, India. Built entirely in code.",
  "main": "electron/main.cjs",
  "author": "RezoxNemesis",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "npm run build && electron .",
    "test:render": "python3 tools/render_test.py",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.rezoxnemesis.damanduo",
    "productName": "Daman Duo",
    "artifactName": "DamanDuo-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "DamanDuo-Windows-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DamanDuo-Windows-Setup.exe",
      "shortcutName": "Daman Duo"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "DamanDuo-Linux.AppImage"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.action-games",
      "icon": "build/icon.png",
      "artifactName": "DamanDuo-macOS.dmg",
      "identity": null
    }
  }
}
